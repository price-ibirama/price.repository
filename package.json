{
  "name": "price.repository",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "typecheck": "next typegen && tsc --noEmit",
    "chat": "tsx --env-file=.env src/chat.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "admin:create-local": "node scripts/create-local-admin.mjs",
    "supabase": "npx supabase --workdir=src",
    "supabase:link-remote": "npm run supabase -- link --project-ref",
    "supabase:start": "npm run supabase -- start --exclude=realtime,logflare,imgproxy,supavisor,vector",
    "supabase:stop": "npm run supabase -- stop --all",
    "supabase:status": "npm run supabase -- status",
    "supabase:generate:types": "npm run --silent supabase -- gen types --local > src/supabase/database.types.ts",
    "supabase:db:diff": "npm run supabase -- db diff",
    "supabase:db:reset": "npm run supabase -- db reset",
    "supabase:migration:new": "npm run supabase -- migration new",
    "supabase:migration:list": "npm run supabase -- migration list",
    "supabase:migration:up": "npm run supabase -- migration up",
    "supabase:migration:down": "npm run supabase -- migration down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafhael-galvao/price.repository.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/rafhael-galvao/price.repository/issues"
  },
  "homepage": "https://github.com/rafhael-galvao/price.repository#readme",
  "devDependencies": {
    "@types/node": "^25.5.0",
    "supabase": "^2.93.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.99.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "http-status-codes": "^2.3.0",
    "lucide-react": "^1.17.0",
    "next": "^16.2.7",
    "radix-ui": "^1.4.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  }
}
